# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database URLs (Prisma)
# Connection pooler (port 6543) - used by Prisma Client at runtime
DATABASE_URL="postgresql://postgres.your-project:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct Postgres (port 5432) - used by Prisma Migrate for schema changes
DIRECT_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"
